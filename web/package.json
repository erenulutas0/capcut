{
  "name": "clip-web",
  "version": "0.1.0",
  "private": true,
  "description": "Clip — W0 web editor shell (no encoder, no cloud, no auth)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "shots": "node scripts/screenshots.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "verify:export:chrome": "node scripts/verify-export.mjs --chrome",
    "matrix:media": "node scripts/generate-matrix-media.mjs",
    "matrix": "node scripts/run-matrix.mjs",
    "matrix:doc": "node scripts/build-support-matrix.mjs",
    "matrix:memory": "node scripts/measure-export-memory.mjs --persistent",
    "matrix:real": "node scripts/run-real-media.mjs"
  },
  "dependencies": {
    "mediabunny": "1.58.1",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
