{
  "name": "clip-web",
  "version": "0.1.0",
  "private": true,
  "description": "LiloCut — local-first web video tool (no cloud, no auth)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/apply-csp.mjs && node scripts/build-sw.mjs",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "shots": "node scripts/screenshots.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "verify:export:chrome": "node scripts/verify-export.mjs --chrome",
    "matrix:media": "node scripts/generate-matrix-media.mjs",
    "matrix": "node scripts/run-matrix.mjs",
    "matrix:doc": "node scripts/build-support-matrix.mjs",
    "matrix:memory": "node scripts/measure-export-memory.mjs --persistent",
    "matrix:real": "node scripts/run-real-media.mjs",
    "quality": "node scripts/quality/run.mjs",
    "test:live": "playwright test -c playwright.live.config.ts",
    "browsers": "node scripts/browsers/run.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "gifenc": "1.0.3",
    "mediabunny": "1.58.1",
    "next": "16.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "picomatch": "4.0.7",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
